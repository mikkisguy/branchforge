{
  "name": "branchforge",
  "version": "0.5.1",
  "private": true,
  "description": "Visual Novel IDE for Ren'Py",
  "scripts": {
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "bump:version": "changeset version && node -e \"const v=require('./apps/backend/package.json').version;const p=require('./package.json');p.version=v;require('fs').writeFileSync('./package.json',JSON.stringify(p,null,2))\" && node scripts/consolidate-changelog.js && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish",
    "install:all": "pnpm install",
    "test": "pnpm -r --filter './packages/*' --filter './apps/*' test",
    "test:unit": "pnpm -r --filter './packages/*' --filter './apps/*' test:unit",
    "test:integration": "pnpm -r --filter './apps/*' test:integration",
    "test:e2e": "echo \"E2E tests not yet implemented\"",
    "dev": "VITE_API_ENV=development pnpm --parallel -r --filter './apps/*' dev",
    "start": "pnpm --filter @branchforge/backend start",
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' build",
    "lint": "pnpm --filter @branchforge/shared --filter @branchforge/backend lint",
    "lint:fix": "pnpm --filter @branchforge/shared --filter @branchforge/backend lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --filter './packages/*' --filter './apps/*' typecheck",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/dist packages/*/node_modules packages/*/dist"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
