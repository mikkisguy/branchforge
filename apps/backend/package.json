{
  "name": "@branchforge/backend",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest --config vitest.unit.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "dotenv -e ../../.env -- vitest run --config vitest.integration.config.ts",
    "db:generate": "tsc -p tsconfig.schema.json && drizzle-kit --config=drizzle.config.cjs generate",
    "db:migrate": "drizzle-kit --config=drizzle.config.cjs push",
    "db:migrate:dev": "drizzle-kit --config=drizzle.config.cjs push --force",
    "db:migrate:test": "tsc -p tsconfig.schema.json && NODE_ENV=test dotenv -e ../../.env -- drizzle-kit --config=drizzle.config.cjs push --force",
    "db:studio": "drizzle-kit --config=drizzle.config.cjs studio",
    "db:backup": "dotenv -e ../../.env -- tsx scripts/db-backup.ts",
    "db:restore": "dotenv -e ../../.env -- tsx scripts/db-restore.ts",
    "db:list": "dotenv -e ../../.env -- tsx scripts/db-list.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@branchforge/shared": "workspace:*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/session": "^11.0.0",
    "@fastify/static": "^9.0.0",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "6.0.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.8.2",
    "ipaddr.js": "^2.3.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.15",
    "@types/pg": "^8.20.0",
    "@vitest/ui": "^4.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "nock": "^14.0.11",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.1",
    "vite-tsconfig-paths": "^6.0.0",
    "vitest": "^4.1.0"
  }
}
