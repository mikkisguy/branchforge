{
  "name": "@branchforge/backend",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "tsc -p tsconfig.schema.json && drizzle-kit --config=drizzle.config.cjs generate",
    "db:migrate": "drizzle-kit --config=drizzle.config.cjs push",
    "db:studio": "drizzle-kit --config=drizzle.config.cjs studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@branchforge/shared": "workspace:*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/session": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "6.0.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.0.0",
    "ipaddr.js": "^2.3.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.13.0",
    "@vitest/ui": "^4.0.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^8.57.0",
    "nock": "^14.0.11",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite-tsconfig-paths": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
