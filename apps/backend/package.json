{
  "name": "@branchforge/backend",
  "version": "0.7.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest --config vitest.unit.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "dotenv -e ../../.env -- vitest run --config vitest.integration.config.ts",
    "db:generate": "tsc -p tsconfig.schema.json && drizzle-kit --config=drizzle.config.cjs generate",
    "db:validate": "tsx scripts/validate-migrations.ts",
    "db:migrate": "dotenv -e ../../.env -- tsx scripts/run-migrations.ts",
    "db:migrate:dev": "drizzle-kit --config=drizzle.config.cjs push",
    "db:migrate:test": "tsc -p tsconfig.schema.json && NODE_ENV=test dotenv -e ../../.env -- tsx scripts/run-migrations.ts",
    "db:studio": "drizzle-kit --config=drizzle.config.cjs studio",
    "db:backup": "dotenv -e ../../.env -- tsx scripts/db-backup.ts",
    "db:restore": "dotenv -e ../../.env -- tsx scripts/db-restore.ts",
    "db:list": "dotenv -e ../../.env -- tsx scripts/db-list.ts",
    "db:reset:test": "dotenv -e ../../.env -- tsx scripts/reset-test-db.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@branchforge/shared": "workspace:*",
    "@date-fns/tz": "^1.4.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/session": "^11.1.1",
    "@fastify/static": "^9.0.0",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "6.0.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.4",
    "ipaddr.js": "^2.3.0",
    "jszip": "^3.10.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.17",
    "@types/pg": "^8.20.0",
    "@vitest/ui": "^4.1.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "nock": "^14.0.12",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.2"
  }
}
