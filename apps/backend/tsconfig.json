{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*",
    "scripts/reset-tech-badges-test-data.ts",
    "scripts/seed-technical-badges.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts"],
  "references": []
}
