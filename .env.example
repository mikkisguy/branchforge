# Database
DATABASE_URL=postgresql://branchforge:branchforge@localhost:5432/branchforge
DATABASE_URL_TEST=postgresql://branchforge:branchforge@localhost:5432/branchforge_test

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
BASE_PATH=/api/

# Session Auth
SESSION_SECRET=change-this-to-a-random-string-in-production
SESSION_MAX_AGE=86400000

# Docker (prod)
POSTGRES_USER=branchforge
POSTGRES_PASSWORD=
POSTGRES_DB=branchforge
PGPORT=

# Encryption key for storing GitLab PAT securely in the database
ENCRYPTION_KEY=

# Frontend Configuration (VITE_ prefix required)
VITE_FRONTEND_BASE_URL=/
VITE_API_BASE_URL=/api
VITE_BACKEND_API_URL=http://localhost:3000
VITE_ALLOWED_HOSTS=.localhost,yourdomain.com
